# Central server
DATABASE_URL=mysql://agriflow:change-me@127.0.0.1:3306/agriflow
SERVER_PORT=4000
# Optional: enables the MySQL tests. The database name must end in _test.
MYSQL_TEST_URL=mysql://root:change-me@127.0.0.1:3307/agriflow_test

# Pump controller
# Per-farm secret used to hash fob UIDs (at least 16 characters). Changing it invalidates enrolled fobs.
FOB_SALT=change-me-to-a-long-random-string
BACKUP_DIR=./backups
CONTROLLER_PORT=4100
CONTROLLER_DB_PATH=./data/controller.db
CONTROLLER_DEVICE_ID=pump-01
# CONTROLLER_DEVICE_TOKEN=
# Set both to upload sessions to the central server. Without them sessions stay on the device.
# SYNC_SERVER_URL=http://127.0.0.1:4000
HARDWARE_DRIVER=simulator
CONTROLLER_TANK_ID=tank-1
# Extra browser origins allowed to open the operator WebSocket, comma separated.
ALLOWED_ORIGINS=
SYNC_INTERVAL_SECONDS=10
# Only for HARDWARE_DRIVER=gpio: Raspberry Pi wiring (libgpiod line numbers).
GPIO_CHIP=gpiochip0
GPIO_RELAY=17
GPIO_METER=27
GPIO_ESTOP=22
GPIO_ESTOP_ENGAGED_LEVEL=high
GPIO_BUTTON_START=23
GPIO_BUTTON_STOP=24
RFID_DEVICE=/dev/input/by-id/usb-reader-event-kbd
